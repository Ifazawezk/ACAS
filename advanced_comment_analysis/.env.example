# Copy this file to .env and fill in your values.

# --- Database ---
# true = local SQLite file (no setup needed); false = use DATABASE_URL below
USE_SQLITE_DEV=true
DATABASE_URL=sqlite:///data/dev.db
# For docker-compose use:
# DATABASE_URL=postgresql://postgres:password@db:5432/commentdb

# --- AI ---
# true = always use the built-in offline analyzer, even if an API key is set
FORCE_LOCAL=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
AI_CONFIDENCE_THRESHOLD=0.5

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Seeding (tools/seed_users.py) ---
# Leave empty to skip creating the manager account
SEED_MANAGER_PASSWORD=
