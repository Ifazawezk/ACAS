<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ACAS Dashboard</title>
    <style>
        /* Theme palettes: dark-red (default) and light-red (.light) */
        :root{
            --bg: #0b0b0b; /* near-black background */
            --panel: #1a0f0f; /* deep panel with subtle red tint */
            --muted: #f3c6c6; /* soft muted for labels */
            --text: #f8f8f8; /* light text */
            --accent: #dc2626; /* red accent */
        }
        .light{
            --bg:#ffffff; /* white background */
            --panel:#fff7f7; /* very light red-tinted panel */
            --muted:#6b7280; /* muted dark text */
            --text:#0f172a; /* dark text */
            --accent:#dc2626; /* same red accent */
        }
        *{box-sizing:border-box}
        body{font-family:Inter,system-ui,Arial,Segoe UI,Roboto;background:var(--bg);color:var(--text);margin:0;padding:20px}
        .wrapper{max-width:1200px;margin:0 auto}
        header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
        .logo{font-weight:700;color:var(--accent);font-size:20px}
        .sub{color:var(--muted);font-size:13px}
        .controls{display:flex;gap:10px;align-items:center}
        .btn{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:8px 10px;border-radius:8px;color:var(--text);cursor:pointer}
        .btn.toggle{background:linear-gradient(90deg,var(--accent),#818cf8);color:#fff;border:none}
        .grid{display:grid;gap:18px}
        .grid.grid-3{grid-template-columns:repeat(4,1fr)}
        .grid.grid-2{grid-template-columns:repeat(2,1fr)}
        .tab.active{background:var(--accent);color:#fff;border:none}
        /* Sidebar tab appearance */
        #tabs .tab{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:transparent;border:none;color:var(--muted);text-align:left;width:100%;justify-content:flex-start}
        #tabs .tab:hover{background:rgba(255,255,255,0.02);color:var(--text)}
        #tabs .tab.active{background:linear-gradient(90deg, rgba(220,38,38,0.14), rgba(220,38,38,0.06));color:#fff;box-shadow:inset 6px 0 0 rgba(220,38,38,0.18)}

        /* Left-side vertical sidebar */
        #tabs{position:fixed;left:16px;top:96px;display:flex;flex-direction:column;gap:12px;width:220px;z-index:1200;padding:14px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border-radius:12px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 40px rgba(2,6,23,0.65)}
        body{padding-left:260px}
        @media (max-width:900px){
            #tabs{position:static;width:auto;flex-direction:row;gap:6px}
            body{padding-left:20px}
        }
        .card{background:var(--panel);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 30px rgba(2,6,23,0.6)}
        .kpi-label{font-size:12px;color:var(--muted);text-transform:uppercase;margin-bottom:8px}
        .kpi-value{font-size:28px;font-weight:800}
        .kpi-accent{border-left:4px solid var(--accent);padding-left:12px}
        .kpi-label{font-size:12px;color:var(--muted);text-transform:uppercase;margin-bottom:8px}
        .kpi-value{font-size:28px;font-weight:700}
        .queue-item{display:flex;justify-content:space-between;gap:12px;padding:12px;border-radius:8px;background:rgba(0,0,0,0.05);align-items:center}
        .queue-comment{color:var(--text);font-size:14px}
        .badge{padding:6px 10px;border-radius:16px;font-weight:700}
        .badge-critical{background:#ffebe9;color:#b91c1c}
        .badge-high{background:#fff7ed;color:#c2410c}
        .badge-medium{background:#fffbe6;color:#854d0d}
        .badge-low{background:#ecfdf5;color:#065f46}
        textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);background:transparent;color:var(--text)}
        .api-status{padding:10px;border-radius:8px;margin-bottom:12px}
        .api-status.ok{background:#ecfdf5;color:#065f46}
        .api-status.err{background:#fff1f2;color:#991b1b}
        footer{margin-top:24px;color:var(--muted);font-size:13px;text-align:center}
        [dir="rtl"]{direction:rtl}
        @media (max-width:800px){.grid.grid-3,.grid.grid-2{grid-template-columns:1fr}}
        /* Transitions and KPI styles */
        .kpi-tile{transition:transform .22s ease, box-shadow .22s ease}
        .kpi-tile:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(2,6,23,0.6)}
        .kpi-trend{font-size:12px;margin-left:8px;color:#34d399;display:inline-flex;align-items:center}
        .kpi-trend.down{color:#fb7185}
        .sentiment-bars div > div > div {transition:width .6s ease}
        /* Auto-routing cards */
        .routing-cards{display:flex;gap:20px;margin-top:18px}
        .route-card{flex:1;padding:28px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));border:1px solid rgba(255,255,255,0.03);display:flex;flex-direction:column;justify-content:center;align-items:center;min-height:160px;transition:transform .18s ease,box-shadow .18s ease}
        .route-card:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(2,6,23,0.6)}
        .route-card h4{margin:0;color:var(--muted);font-size:16px;text-align:center}
        .route-count{font-size:46px;font-weight:900;margin-top:12px;letter-spacing:-1px}
        .route-sub{color:var(--muted);font-size:13px;margin-top:8px;text-align:center}
        .route-icon{width:44px;height:44px;border-radius:10px;background:rgba(255,255,255,0.02);display:flex;align-items:center;justify-content:center;margin-bottom:10px}
        .route-blue .route-icon{background:linear-gradient(180deg, rgba(59,130,246,0.08), rgba(59,130,246,0.02));}
        .route-purple .route-icon{background:linear-gradient(180deg, rgba(139,92,246,0.08), rgba(139,92,246,0.02));}
        .route-green .route-icon{background:linear-gradient(180deg, rgba(16,185,129,0.08), rgba(16,185,129,0.02));}
        .route-blue{box-shadow: inset 0 0 0 1px rgba(59,130,246,0.06);border:1px solid rgba(59,130,246,0.18)}
        .route-purple{box-shadow: inset 0 0 0 1px rgba(139,92,246,0.06);border:1px solid rgba(139,92,246,0.18)}
        .route-green{box-shadow: inset 0 0 0 1px rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.18)}
        .routing-layout{display:flex;gap:18px;margin-top:16px}
        .routing-left{width:280px;display:flex;flex-direction:column;gap:12px}
        .mini-kpi{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}
        .mini-kpi .val{font-weight:800;font-size:20px}
        .mini-spark{width:100%;height:36px}
        @media (max-width:900px){.routing-layout{flex-direction:column}.routing-left{width:auto}}
        /* Modal for rule editor */
        .modal-backdrop{position:fixed;inset:0;background:rgba(2,6,23,0.6);display:none;align-items:center;justify-content:center;z-index:2000}
        .modal{background:var(--panel);padding:18px;border-radius:12px;max-width:900px;width:94%;box-shadow:0 20px 60px rgba(2,6,23,0.75);border:1px solid rgba(255,255,255,0.03)}
        .modal .row{display:flex;gap:8px;align-items:center}
        .modal .rules-list{max-height:320px;overflow:auto;margin-top:12px;border-radius:8px;padding:8px;background:rgba(255,255,255,0.01)}
        .fade-in{animation:fadeIn .28s ease}
        @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
        /* area chart */
        .area-chart{background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));padding:12px;border-radius:10px}
        .status-bars .row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
        .status-bars .bar{height:10px;background:rgba(255,255,255,0.04);border-radius:8px;overflow:hidden}
        .status-bars .fill{height:100%;border-radius:8px}
    </style>
</head>
<body>
    <div class="wrapper" id="page">
        <header>
            <div>
                <div class="logo" id="logo-text">ACAS</div>
                <div class="sub" id="subtitle">Your comment inbox, analyzed & routed</div>
            </div>
            <div class="controls">
                <select id="lang" class="btn" title="Language">
                    <option value="en">English</option>
                    <option value="ar">العربية</option>
                </select>
                <button id="theme-toggle" class="btn">Toggle theme</button>
                <div id="api-alert"></div>
            </div>
        </header>

        <!-- Tabs -->
        <div style="margin:12px 0; display:flex; gap:8px; align-items:center;">
            <div id="tabs" style="display:flex;gap:8px;flex-direction:column">
                <button class="btn tab" data-tab="live">📊 Live Dashboard</button>
                <button class="btn tab" data-tab="routing">⚙️ Auto Routing</button>
                <button class="btn tab" data-tab="sentic">🔎 Sentic Mapping</button>
                <button class="btn tab" data-tab="config">🔧 Configuration</button>
                <button class="btn tab" data-tab="test">🧪 Test</button>
                <button class="btn tab" data-tab="inbox">📥 Inbox</button>
                <div style="margin-top:16px;border-top:1px solid rgba(255,255,255,0.03);padding-top:12px;color:var(--muted);font-size:13px">
                    <div style="font-weight:700;color:var(--text)">Admin User</div>
                    <div style="color:#34d399;margin-top:6px;font-size:12px">● System Online</div>
                </div>
            </div>
            <div style="margin-left:auto;color:var(--muted);font-size:13px">Theme and Language</div>
        </div>

        <div class="card api-status" id="api-status"></div>
        <div id="live" class="tab-panel">
            <div class="grid grid-3" id="kpi-row">
            <div class="card">
                <div class="kpi-label" id="label-comments">Comments Today</div>
                <div class="kpi-value" id="total-analyzed">0</div>
                <div class="kpi-spark" style="margin-top:8px"><svg id="spark-total" width="100" height="28"></svg></div>
            </div>
            <div class="card">
                <div class="kpi-label" id="label-attention">Need Attention</div>
                <div class="kpi-value" id="high-priority">0</div>
                <div class="kpi-spark" style="margin-top:8px"><svg id="spark-high" width="100" height="28"></svg></div>
            </div>
            <div class="card">
                <div class="kpi-label" id="label-resolved">Resolved Today</div>
                <div class="kpi-value" id="resolved">0</div>
                <div class="kpi-spark" style="margin-top:8px"><svg id="spark-resolved" width="100" height="28"></svg></div>
            </div>
            <div class="card kpi-accent">
                <div class="kpi-label">Avg. Confidence</div>
                <div class="kpi-value" id="avg-confidence">94.2%</div>
                <div class="kpi-spark" style="margin-top:8px"><svg id="spark-confidence" width="100" height="28"></svg></div>
            </div>
        </div>

        <!-- Additional KPI row -->
        <div style="margin-top:12px" class="grid grid-3">
            <div class="card">
                <div class="kpi-label">Analyzed (24h)</div>
                <div class="kpi-value" id="kpi-24h">0</div>
            </div>
            <div class="card" id="kpi-crisis-card">
                <div class="kpi-label">Crisis Alerts</div>
                <div class="kpi-value" id="kpi-crisis">0</div>
            </div>
            <div class="card">
                <div class="kpi-label">Noise Filtered</div>
                <div class="kpi-value" id="kpi-noise">0%</div>
            </div>
            <div class="card">
                <div class="kpi-label">Top Complaint</div>
                <div class="kpi-value" id="kpi-top">—</div>
            </div>
        </div>

        <!-- Live dashboard details -->
        <div id="live-details" class="tab-panel" style="margin-top:12px">
            <div class="grid grid-2">
                <div class="card">
                    <h3>Sentiment Distribution</h3>
                    <div id="sentiment-list" style="display:flex;flex-direction:column;gap:10px;margin-top:8px"></div>
                </div>
                <div class="card">
                    <h3>Priority Breakdown</h3>
                    <div id="live-priority-list" style="display:flex;flex-direction:column;gap:10px;margin-top:8px"></div>
                </div>
            </div>
            <div style="display:flex;gap:12px;margin-top:12px">
                <button id="refresh-metrics" class="btn">Refresh</button>
                <div style="color:var(--muted);align-self:center">Last updated: <span id="metrics-updated">—</span></div>
            </div>
        </div>

        <!-- Auto-routing panel -->
        <div id="routing" class="tab-panel" style="display:none;margin-top:16px">
            <div class="card">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <div>
                        <h3 style="margin:0">Auto-Routing Logic</h3>
                        <div style="color:var(--muted);font-size:13px;margin-top:6px">How ACAS distributes tickets across your stack</div>
                    </div>
                    <div>
                        <button id="edit-rules" class="btn" style="background:var(--accent);color:#fff;border:none;padding:10px 14px;border-radius:8px">Edit Rules</button>
                    </div>
                </div>

                <div class="routing-layout">
                    <div class="routing-left">
                        <div class="mini-kpi card">
                            <div style="color:var(--muted);font-size:12px">Total Routed (24h)</div>
                            <div class="val" id="mini-total">—</div>
                            <svg class="mini-spark" id="mini-spark" viewBox="0 0 100 36"></svg>
                        </div>
                        <div class="mini-kpi card">
                            <div style="color:var(--muted);font-size:12px">Avg. Confidence</div>
                            <div class="val" id="mini-confidence">—</div>
                        </div>
                        <div class="mini-kpi card">
                            <div style="color:var(--muted);font-size:12px">Crisis Alerts</div>
                            <div class="val" id="mini-crisis">—</div>
                        </div>
                        <div class="mini-kpi card">
                            <div style="color:var(--muted);font-size:12px">Noise Filtered</div>
                            <div class="val" id="mini-noise">—</div>
                        </div>
                        <div class="mini-kpi card" style="display:flex;flex-direction:column;align-items:center;gap:8px">
                            <svg width="120" height="120" viewBox="0 0 42 42">
                                <circle r="15.9155" cx="21" cy="21" fill="transparent" stroke="#222" stroke-width="8"></circle>
                                <g id="mini-donut"></g>
                            </svg>
                            <div style="color:var(--muted);font-size:12px">Routing share</div>
                        </div>
                    </div>

                    <div class="routing-right" style="flex:1">
                        <div class="routing-cards" style="margin-top:0">
                                <div class="route-card route-blue">
                                    <div class="route-icon">💬</div>
                                    <h4>Support Queue</h4>
                                    <div class="route-count" id="r-support">—</div>
                                    <div class="route-sub">General inquiries and account issues · Total routed</div>
                                </div>
                            <div class="route-card route-purple">
                                <div class="route-icon">🖥️</div>
                                <h4>Tech / Bugs</h4>
                                <div class="route-count" id="r-tech">—</div>
                                <div class="route-sub">API errors, crashes, and performance logs · Total routed</div>
                            </div>
                            <div class="route-card route-green">
                                <div class="route-icon">⚡</div>
                                <h4>Product / Feedback</h4>
                                <div class="route-count" id="r-product">—</div>
                                <div class="route-sub">Feature requests and UX suggestions · Total routed</div>
                            </div>
                        </div>

                        <div style="margin-top:18px;color:var(--muted)">Configure rules below or press <strong>Edit Rules</strong> to open the rule editor.</div>
                        <div style="margin-top:12px">
                            <h4 style="margin-top:12px">Add rule</h4>
                            <div style="display:flex;gap:8px;margin-top:8px">
                                <input id="rule-pattern" placeholder="match text or regex" style="flex:1;padding:8px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)" />
                                <select id="rule-priority" class="btn">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                                <button id="add-rule" class="btn">Add</button>
                            </div>
                        </div>
                        <div id="routing-rules" style="margin-top:12px">Loading routing rules…</div>
                    </div>
                </div>
            </div>

            <!-- Rules editor modal -->
            <div id="rule-modal" class="modal-backdrop">
                <div class="modal fade-in">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <h3 style="margin:0">Edit Routing Rules</h3>
                        <div><button id="close-modal" class="btn">Close</button></div>
                    </div>
                    <div style="color:var(--muted);margin-top:8px">Edit, enable/disable, or delete rules. Changes save to the backend when available.</div>
                    <div class="row" style="margin-top:12px">
                        <input id="modal-new-pattern" placeholder="pattern or regex" style="flex:1;padding:8px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)" />
                        <select id="modal-new-priority" class="btn"><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select>
                        <button id="modal-add" class="btn">Add</button>
                    </div>
                    <div class="rules-list" id="modal-rules-list"></div>
                </div>
            </div>
        </div>

        <!-- Sentic mapping panel -->
        <div id="sentic" class="tab-panel" style="display:none;margin-top:16px">
            <div class="card">
                <h3>Sentic Mapping</h3>
                <p style="color:var(--muted)">Configure how emotion/intent maps to priority and responses. Visualize sentiment clusters here.</p>
                <div id="sentic-map">Visualization placeholder</div>
                <div style="margin-top:12px">
                    <h4>Mappings</h4>
                    <div id="sentic-table" style="margin-top:8px"></div>
                    <div style="display:flex;gap:8px;margin-top:8px">
                        <input id="map-emotion" placeholder="emotion (e.g. angry)" style="padding:8px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)" />
                        <select id="map-priority" class="btn">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                        <button id="add-mapping" class="btn">Add</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Configuration panel -->
        <div id="config" class="tab-panel" style="display:none;margin-top:16px">
            <div class="card">
                <h3>Configuration</h3>
                <p style="color:var(--muted)">Environment, AI settings, thresholds and integrations.</p>
                <div id="config-list">Local settings placeholder</div>
                <div style="margin-top:12px">
                    <label style="display:flex;gap:8px;align-items:center"><input id="cfg-force-local" type="checkbox" /> Force local AI (no real API)</label>
                    <div style="margin-top:8px;display:flex;gap:8px;align-items:center">
                        <label style="color:var(--muted)">Confidence threshold:</label>
                        <input id="cfg-confidence" type="number" min="0" max="1" step="0.05" style="width:80px;padding:6px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)" />
                        <button id="save-config" class="btn">Save</button>
                    </div>
                </div>
            </div>
        </div>

            <div class="grid grid-2" style="margin-top:16px">
            <div class="card">
                <h3 id="sentiment-title">How are users feeling?</h3>
                    <div id="sentiment-bars" style="margin-top:8px">Loading…</div>
            </div>
            <div class="card">
                <h3 id="priority-title">What needs to be done?</h3>
                    <div id="priority-chart" style="display:flex;gap:12px;align-items:center">
                        <div style="flex:1">
                            <div id="routing-priority-list">Loading…</div>
                        </div>
                        <div style="width:160px;height:160px;display:flex;align-items:center;justify-content:center">
                            <svg id="routing-donut" width="140" height="140" viewBox="0 0 42 42">
                                <circle r="15.9155" cx="21" cy="21" fill="transparent" stroke="#222" stroke-width="8"></circle>
                                <g id="donut-segments"></g>
                                <text x="21" y="22.5" text-anchor="middle" font-size="4" fill="var(--muted)" id="donut-center">0</text>
                            </svg>
                        </div>
                    </div>
            </div>
        </div>
        <!-- Area chart and ticket status breakdown -->
        <div style="margin-top:16px;display:grid;grid-template-columns:2fr 1fr;gap:18px">
            <div class="card area-chart">
                <div style="display:flex;justify-content:space-between;align-items:center"><div><h3 style="margin:0">Comments Over Time</h3><div style="color:var(--muted);font-size:12px">Last 24 hours</div></div><div><button id="download-history" class="btn">Export</button></div></div>
                <div style="margin-top:12px"><svg id="area-comments" width="100%" height="120" viewBox="0 0 600 120"></svg></div>
            </div>
            <div class="card">
                <h3 style="margin:0">Ticket Status</h3>
                <div style="color:var(--muted);font-size:13px;margin-top:6px">Open, in progress, closed distribution</div>
                <div class="status-bars" id="status-bars" style="margin-top:12px"></div>
                <div style="margin-top:12px;color:var(--muted);font-size:13px">Top complaint: <span id="top-complaint-text">—</span></div>
            </div>
        </div>
        </div>

        <div id="test" class="tab-panel" style="display:none">
            <div class="card" style="margin-top:0px">
            <h3 id="test-title">Test an example</h3>
            <textarea id="test-comment" placeholder="Paste a comment and press Analyze"></textarea>
            <div style="display:flex;gap:8px;margin-top:8px">
                <button id="test-btn" class="btn toggle">Analyze</button>
                <button id="append-btn" class="btn">Add to queue</button>
            </div>
            <div id="test-result" style="margin-top:12px;display:none"></div>
            </div>
        </div>

        <div id="inbox" class="tab-panel" style="display:none;margin-top:16px">
            <div class="card">
                <h3 id="inbox-title">Your Inbox</h3>
                <div id="queue-container"></div>
            </div>
        </div>

        <footer id="footer">Built locally • No external dependencies</footer>
    </div>

    <script>
        const API = 'http://127.0.0.1:8000';
        const page = document.getElementById('page');
        const langSel = document.getElementById('lang');
        const themeToggle = document.getElementById('theme-toggle');

        const i18n = {
            en: {
                subtitle: 'Your comment inbox, analyzed & routed',
                liveTab: 'Live Dashboard',
                routingTab: 'Auto Routing',
                senticTab: 'Sentic Mapping',
                configTab: 'Configuration',
                labelComments: 'Comments Today',
                labelAttention: 'Need Attention',
                labelResolved: 'Resolved Today',
                sentimentTitle: 'How are users feeling?',
                priorityTitle: 'What needs to be done?',
                testTitle: 'Test an example',
                inboxTitle: 'Your Inbox',
                analyzeBtn: 'Analyze',
                addBtn: 'Add to queue',
                footer: 'Built locally • No external dependencies',
            },
            ar: {
                subtitle: 'صندوق التعليقات — تحليل وتوجيه',
                liveTab: 'لوحة مباشرة',
                routingTab: 'توجيه تلقائي',
                senticTab: 'خريطة المشاعر',
                configTab: 'الإعدادات',
                labelComments: 'التعليقات اليوم',
                labelAttention: 'تحتاج انتباهاً',
                labelResolved: 'تم حلها اليوم',
                sentimentTitle: 'ما هو شعور المستخدمين؟',
                priorityTitle: 'ما الذي يجب القيام به؟',
                testTitle: 'اختبر تعليقاً',
                inboxTitle: 'صندوق الوارد',
                analyzeBtn: 'حلل',
                addBtn: 'أضف إلى القائمة',
                footer: 'تشغيل محلي • لا تبعيات خارجية',
            }
        };

        function setLanguage(l){
            const s = i18n[l] || i18n.en;
            document.getElementById('subtitle').textContent = s.subtitle;
            // update tab labels if present
            const tabMap = {
                live: s.liveTab || 'Live',
                routing: s.routingTab || 'Auto Routing',
                sentic: s.senticTab || 'Sentic Mapping',
                config: s.configTab || 'Configuration',
                test: s.testTitle || 'Test',
                inbox: s.inboxTitle || 'Inbox'
            };
            Object.keys(tabMap).forEach(k=>{
                const btn = document.querySelector(`.tab[data-tab="${k}"]`);
                if(btn) btn.textContent = tabMap[k];
            });
            document.getElementById('label-comments').textContent = s.labelComments;
            document.getElementById('label-attention').textContent = s.labelAttention;
            document.getElementById('label-resolved').textContent = s.labelResolved;
            document.getElementById('sentiment-title').textContent = s.sentimentTitle;
            document.getElementById('priority-title').textContent = s.priorityTitle;
            document.getElementById('test-title').textContent = s.testTitle;
            document.getElementById('inbox-title').textContent = s.inboxTitle;
            document.getElementById('test-btn').textContent = s.analyzeBtn;
            document.getElementById('append-btn').textContent = s.addBtn;
            document.getElementById('footer').textContent = s.footer;
            document.documentElement.lang = l;
            if(l==='ar') document.documentElement.setAttribute('dir','rtl'); else document.documentElement.setAttribute('dir','ltr');
            localStorage.setItem('acas_lang', l);
        }

        function toggleTheme(){
            document.body.classList.toggle('light');
            localStorage.setItem('acas_theme', document.body.classList.contains('light') ? 'light':'dark');
        }

        themeToggle.addEventListener('click', toggleTheme);
        langSel.addEventListener('change', ()=> setLanguage(langSel.value));

        // Tabs logic
        const tabs = Array.from(document.querySelectorAll('.tab'));
        const panels = Array.from(document.querySelectorAll('.tab-panel'));
        async function showTab(name){
            panels.forEach(p=> p.style.display = p.id===name ? '' : 'none');
            tabs.forEach(b=> b.classList.toggle('active', b.dataset.tab===name));
            localStorage.setItem('acas_tab', name);
            // load tab data (ensure each tab is fully populated when shown)
            if(name==='live') { await loadMetrics(); await loadHistory(); }
            if(name==='routing') { await loadRoutingTab().catch(()=> loadRoutingFallback()); }
            if(name==='sentic') { await loadSenticTab(); }
            if(name==='config') { await loadConfigTab(); }
            if(name==='inbox') { await loadInbox(); }
        }
        tabs.forEach(t=> t.addEventListener('click', ()=> showTab(t.dataset.tab)));
        // initialize tab
        const savedTab = localStorage.getItem('acas_tab') || 'live';
        showTab(savedTab);

        function addQueueItem(comment, meta, badge){
            const container = document.getElementById('queue-container');
            const div = document.createElement('div');
            div.className = 'queue-item';
            div.innerHTML = `<div style="flex:1"><div class="queue-comment">${escapeHtml(comment)}</div><div style="color:var(--muted);font-size:12px">${meta}</div></div><div><span class="badge ${badge}">${badge.replace('badge-','').toUpperCase()}</span></div>`;
            container.prepend(div);
        }

        function escapeHtml(s){ return s.replace(/[&<>'"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        document.getElementById('test-btn').addEventListener('click', async ()=>{
            const txt = document.getElementById('test-comment').value.trim();
            if(!txt) return alert('Please add a comment');
            const btn = document.getElementById('test-btn'); btn.disabled=true; btn.textContent='Analyzing...';
            try{
                const res = await fetch(API+'/ai/analyze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({content:txt})});
                if(!res.ok) throw new Error('API error');
                const data = await res.json();
                const out = document.getElementById('test-result');
                out.style.display='block';
                out.innerHTML = `<strong>Emotion:</strong> ${data.emotion} &nbsp; <strong>Intent:</strong> ${data.intent} <br><strong>Priority:</strong> ${data.priority} &nbsp; <strong>Confidence:</strong> ${Math.round(data.confidence*100)}% <p style="margin-top:8px"><strong>Suggested:</strong> ${data.suggested_response || ''}</p>`;
                const badge = data.priority==='Critical' ? 'badge-critical' : (data.priority==='High' ? 'badge-high': (data.priority==='Medium'?'badge-medium':'badge-low'));
                addQueueItem(txt, `${data.intent} · just now · ${Math.round(data.confidence*100)}%`, badge);
            }catch(e){
                alert('Analysis failed: '+e.message);
            }finally{btn.disabled=false;btn.textContent=i18n[localStorage.getItem('acas_lang')||'en'].analyzeBtn}
        });

        document.getElementById('append-btn').addEventListener('click', async ()=>{
            const txt = document.getElementById('test-comment').value.trim(); if(!txt) return alert('Please add a comment');
            const btn = document.getElementById('append-btn'); btn.disabled=true; btn.textContent='Adding...';
            try{
                const r = await fetch(API + '/comments/', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({content: txt, source: 'dashboard'})});
                if(!r.ok) throw new Error('Failed to save');
                const saved = await r.json();
                const pr = saved.priority || 'Low';
                const badge = pr==='Critical' ? 'badge-critical' : (pr==='High' ? 'badge-high' : (pr==='Medium' ? 'badge-medium':'badge-low'));
                addQueueItem(saved.content || txt, `${saved.intent || 'manual'} · just now · ${Math.round((saved.confidence||1)*100)}%`, badge);
                document.getElementById('test-comment').value = '';
            }catch(e){
                alert('Failed to add to queue: ' + e.message);
            }finally{btn.disabled=false; btn.textContent=i18n[localStorage.getItem('acas_lang')||'en'].addBtn}
        });

        async function loadMetrics(){
            try{
                const r = await fetch(API+'/dashboard/metrics');
                if(!r.ok) throw new Error('no metrics');
                const d = await r.json();
                document.getElementById('total-analyzed').textContent = d.total_comments || 0;
                document.getElementById('high-priority').textContent = d.high_priority_tickets || 0;
                document.getElementById('resolved').textContent = (d.ticket_status_breakdown||[]).reduce((s,t)=> s + (t.status==='Closed'?t.count:0),0) || 0;
                // render sentiment bars from metric distribution
                renderSentimentBars(d.sentiment_distribution || [], d.total_comments || 0);
                // render priority list
                renderPriorityList(d.priority_distribution || []);
                // try to compute avg confidence, routing breakdown, crisis alerts, noise filtered
                try{
                    const c = await fetch(API + '/comments?limit=500');
                    if(c.ok){
                        const comments = await c.json();
                        const avg = comments.length ? (comments.reduce((s,x)=> s + (x.confidence||0),0) / comments.length) : 0;
                        document.getElementById('avg-confidence').textContent = `${Math.round((avg||0)*100)}%`;
                        renderRoutingOverview(comments);
                        // crisis alerts estimation
                        const crisis = Math.round((d.pct_negative || 0) * (d.total_comments||0));
                        document.getElementById('kpi-crisis').textContent = crisis;
                        // noise filtered estimation
                        const cfg = loadConfig();
                        const noiseCount = comments.filter(x=> (x.confidence||0) < (cfg.confidence||0.5)).length;
                        const noisePct = comments.length ? Math.round((noiseCount / comments.length) * 100) : 0;
                        document.getElementById('kpi-noise').textContent = `${noisePct}%`;
                        // 24h total
                        document.getElementById('kpi-24h').textContent = d.total_comments || 0;
                        // top complaint
                        document.getElementById('kpi-top').textContent = d.top_complaint || '—';
                        document.getElementById('top-complaint-text').textContent = d.top_complaint || '—';
                        // render ticket status bars
                        renderStatusBars(d.ticket_status_breakdown || []);
                    }else{
                        document.getElementById('avg-confidence').textContent = '—';
                    }
                }catch(e){ document.getElementById('avg-confidence').textContent = '—'; }
                document.getElementById('api-status').className='card api-status ok';
                document.getElementById('api-status').textContent='Backend: OK';
            }catch(e){
                document.getElementById('api-status').className='card api-status err';
                document.getElementById('api-status').textContent='Backend: Unreachable';
            }
        }

        function renderPriorityList(list){
            const el = document.getElementById('live-priority-list');
            if(!list || !list.length){ el.innerHTML = '<div style="color:var(--muted)">No priority data</div>'; return; }
            el.innerHTML='';
            list.forEach(it=>{
                const div = document.createElement('div'); div.style.display='flex'; div.style.justifyContent='space-between'; div.style.marginBottom='6px'; div.innerHTML = `<div style="color:var(--muted)">${it.priority}</div><div style="font-weight:700">${it.count}</div>`; el.appendChild(div);
            });
        }

        function renderSentimentBars(dist, total){
            const el = document.getElementById('sentiment-bars'); el.innerHTML='';
            if(!dist || !dist.length){ el.innerHTML = '<div style="color:var(--muted)">No sentiment data</div>'; return; }
            const colors = ['#10b981','#f97316','#60a5fa','#ef4444','#a78bfa','#94a3b8'];
            dist.sort((a,b)=> b.count - a.count).forEach((s,idx)=>{
                const pct = total ? Math.round((s.count/total)*100) : 0;
                const row = document.createElement('div'); row.style.marginBottom='10px';
                row.innerHTML = `<div style="display:flex;justify-content:space-between"><div style="font-weight:700">${escapeHtml(s.emotion)}</div><div style="color:var(--muted)">${pct}%</div></div><div style="height:10px;background:rgba(255,255,255,0.04);border-radius:6px;margin-top:6px"><div style="height:10px;border-radius:6px;width:${pct}%;background:${colors[idx % colors.length]}"></div></div>`;
                el.appendChild(row);
            });
        }

        function renderRoutingOverview(comments){
            // Map intents to three buckets
            const supportKeys = ['question','support','inquiry','help','billing','account'];
            const techKeys = ['bug','error','crash','issue','problem','technical','bug_report'];
            const productKeys = ['feature','request','suggestion','feedback','idea','feature_request'];
            let s=0,t=0,p=0;
            comments.forEach(c=>{
                const intent = (c.intent||'').toLowerCase();
                if(supportKeys.some(k=> intent.includes(k))) s++; else if(techKeys.some(k=> intent.includes(k))) t++; else if(productKeys.some(k=> intent.includes(k))) p++; else s++; // default to support
            });
            function fmt(n){ if(n>=1000) return (Math.round((n/1000)*10)/10)+'k'; return String(n); }
            document.getElementById('r-support').textContent = fmt(s);
            document.getElementById('r-tech').textContent = fmt(t);
            document.getElementById('r-product').textContent = fmt(p);
            // populate routing-priority-list summary
            const routingListEl = document.getElementById('routing-priority-list');
            if(routingListEl){ routingListEl.innerHTML = `<div style="display:flex;justify-content:space-between"><div style="color:var(--muted)">Support</div><div style="font-weight:700">${fmt(s)}</div></div><div style="display:flex;justify-content:space-between;margin-top:6px"><div style="color:var(--muted)">Tech</div><div style="font-weight:700">${fmt(t)}</div></div><div style="display:flex;justify-content:space-between;margin-top:6px"><div style="color:var(--muted)">Product</div><div style="font-weight:700">${fmt(p)}</div></div>`; }
            // draw donut
            const total = s + t + p || 1;
            const vals = [s, t, p];
            const colors = ['#3b82f6','#8b5cf6','#10b981'];
            drawDonut(vals, colors);
            const center = document.getElementById('donut-center'); center.textContent = total.toString();
        }

        function drawDonut(values, colors){
            // draw animated donut using stroke-dasharray on stacked circles
            const g = document.getElementById('donut-segments'); g.innerHTML='';
            const total = values.reduce((s,v)=> s+v,0) || 1;
            const circumference = 2 * Math.PI * 15.9155;
            let offset = 0;
            values.forEach((v,i)=>{
                const frac = v/total;
                const segLen = frac * circumference;
                if(segLen <= 0) { offset += segLen; return; }
                const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
                c.setAttribute('r','15.9155'); c.setAttribute('cx','21'); c.setAttribute('cy','21');
                c.setAttribute('fill','transparent'); c.setAttribute('stroke', colors[i%colors.length]);
                c.setAttribute('stroke-width','8');
                c.setAttribute('stroke-dasharray', `${segLen} ${circumference}`);
                c.setAttribute('stroke-dashoffset', `${-offset}`);
                c.setAttribute('stroke-linecap','butt');
                c.setAttribute('transform','rotate(-90 21 21)');
                c.style.transition = 'stroke-dasharray .8s ease, stroke-dashoffset .8s ease';
                g.appendChild(c);
                offset += segLen;
            });
        }

        // --- Tab loaders ---
        async function loadRoutingTab(){
            // ensure rules rendered
            await renderRoutingRules();
            // compute routing distribution (support/tech/product)
            try{
                const r = await fetch(API + '/comments?limit=1000');
                if(!r.ok) throw new Error('no');
                const comments = await r.json();
                renderRoutingOverview(comments);
                // also populate mini KPIs from comments & metrics
                try{
                    const m = await fetch(API + '/dashboard/metrics');
                    if(m.ok){ const md = await m.json(); populateRoutingKPIs(md, comments); }
                }catch(e){}
            }catch(e){ /* ignore */ }
        }

        // Fallback: build routing overview from aggregate metrics if comments fetch fails
        async function loadRoutingFallback(){
            try{
                const r = await fetch(API + '/dashboard/metrics'); if(!r.ok) throw new Error('no metrics'); const d = await r.json();
                // map priority_distribution to our three buckets approximately
                const pri = d.priority_distribution || [];
                const counts = {support:0,tech:0,product:0};
                pri.forEach(p=>{
                    const name = (p.priority||'').toLowerCase();
                    // heuristics
                    if(['critical','high'].includes(name)) { counts.tech += p.count; }
                    else if(['medium'].includes(name)) { counts.product += p.count; }
                    else { counts.support += p.count; }
                });
                renderRoutingOverview(Object.keys({}).length? []: []);
                // directly set counts
                function fmt(n){ if(n>=1000) return (Math.round((n/1000)*10)/10)+'k'; return String(n); }
                document.getElementById('r-support').textContent = fmt(counts.support||0);
                document.getElementById('r-tech').textContent = fmt(counts.tech||0);
                document.getElementById('r-product').textContent = fmt(counts.product||0);
                drawDonut([counts.support, counts.tech, counts.product], ['#3b82f6','#8b5cf6','#10b981']);
                document.getElementById('donut-center').textContent = ((counts.support||0)+(counts.tech||0)+(counts.product||0)).toString();
            }catch(e){ /* nothing */ }
        }

        function populateRoutingKPIs(metrics, comments){
            // metrics: dashboard/metrics response, comments: array
            try{
                document.getElementById('mini-total').textContent = metrics.total_comments || 0;
                const avg = comments && comments.length ? Math.round((comments.reduce((s,x)=> s + (x.confidence||0),0)/comments.length)*100) : Math.round((metrics.avg_confidence||0)*100);
                document.getElementById('mini-confidence').textContent = `${avg}%`;
                document.getElementById('mini-crisis').textContent = Math.round((metrics.pct_negative||0)*(metrics.total_comments||0)) || 0;
                // noise: fraction below confidence threshold (use 0.5 default)
                const cfg = loadConfig(); const thr = cfg.confidence || 0.5;
                const noise = comments && comments.length ? Math.round((comments.filter(c=> (c.confidence||0) < thr).length / comments.length)*100) : 0;
                document.getElementById('mini-noise').textContent = `${noise}%`;
                // draw mini spark from hourly history if available
                fetch(API + '/dashboard/metrics/history').then(r=> r.ok ? r.json() : null).then(h=>{ if(!h || !h.hours) return; const vals = h.hours.map(x=> x.count); drawMiniSpark(vals, 'mini-spark'); });
                // draw mini donut from comments intent buckets
                try{ const supportKeys = ['question','support','inquiry','help','billing','account']; const techKeys = ['bug','error','crash','issue','problem','technical','bug_report']; const productKeys = ['feature','request','suggestion','feedback','idea','feature_request']; let s=0,t=0,p=0; (comments||[]).forEach(c=>{ const intent=(c.intent||'').toLowerCase(); if(supportKeys.some(k=> intent.includes(k))) s++; else if(techKeys.some(k=> intent.includes(k))) t++; else if(productKeys.some(k=> intent.includes(k))) p++; else s++; }); const g = document.getElementById('mini-donut'); g.innerHTML=''; const total = s+t+p||1; const colors = ['#3b82f6','#8b5cf6','#10b981']; const circumference = 2 * Math.PI * 15.9155; let offset=0; [s,t,p].forEach((v,i)=>{ const seg = (v/total)*circumference; if(seg<=0) return; const c = document.createElementNS('http://www.w3.org/2000/svg','circle'); c.setAttribute('r','15.9155'); c.setAttribute('cx','21'); c.setAttribute('cy','21'); c.setAttribute('fill','transparent'); c.setAttribute('stroke',colors[i]); c.setAttribute('stroke-width','8'); c.setAttribute('stroke-dasharray', `${seg} ${circumference}`); c.setAttribute('stroke-dashoffset', `${-offset}`); c.setAttribute('transform','rotate(-90 21 21)'); g.appendChild(c); offset += seg; }); }catch(e){}
            }catch(e){/* ignore */}
        }

        function drawMiniSpark(values, svgId){
            const svg = document.getElementById(svgId); if(!svg) return; svg.innerHTML=''; if(!values || !values.length) return;
            const w=100,h=36; const max=Math.max(...values), min=Math.min(...values); const len=values.length; const px=i=> (i/(len-1))*(w-6)+3; const py=v=> max===min ? h/2 : h-4-((v-min)/(max-min))*(h-8);
            const points = values.map((v,i)=> `${px(i)},${py(v)}`).join(' ');
            const poly = document.createElementNS('http://www.w3.org/2000/svg','polyline'); poly.setAttribute('points', points); poly.setAttribute('fill','none'); poly.setAttribute('stroke','#fff'); poly.setAttribute('stroke-opacity','0.85'); poly.setAttribute('stroke-width','1.4'); svg.appendChild(poly);
        }

        async function loadSenticTab(){
            // render mappings table
            await renderSenticMappings();
            // draw sentiment distribution chart
            try{
                const r = await fetch(API + '/dashboard/metrics'); if(!r.ok) throw new Error('no'); const d = await r.json();
                const el = document.getElementById('sentic-map'); el.innerHTML = '';
                const svg = document.createElementNS('http://www.w3.org/2000/svg','svg'); svg.setAttribute('width','100%'); svg.setAttribute('height','120'); svg.setAttribute('viewBox','0 0 600 120');
                const dist = d.sentiment_distribution || [];
                const total = d.total_comments || 0;
                const colors = ['#10b981','#f97316','#60a5fa','#ef4444','#a78bfa'];
                dist.sort((a,b)=> b.count - a.count);
                const barW = 540; const startX = 30; const stepY = 18; let y=18; let idx=0;
                dist.forEach(s=>{
                    const pct = total ? (s.count/total) : 0; const w = Math.max(2, Math.round(pct * barW));
                    const rect = document.createElementNS('http://www.w3.org/2000/svg','rect'); rect.setAttribute('x', startX); rect.setAttribute('y', y-10); rect.setAttribute('width', w); rect.setAttribute('height', 12); rect.setAttribute('fill', colors[idx % colors.length]);
                    const text = document.createElementNS('http://www.w3.org/2000/svg','text'); text.setAttribute('x', startX - 8); text.setAttribute('y', y); text.setAttribute('font-size','10'); text.setAttribute('fill', 'var(--muted)'); text.textContent = s.emotion;
                    const pctText = document.createElementNS('http://www.w3.org/2000/svg','text'); pctText.setAttribute('x', startX + w + 8); pctText.setAttribute('y', y); pctText.setAttribute('font-size','10'); pctText.setAttribute('fill', 'var(--muted)'); pctText.textContent = `${Math.round(pct*100)}%`;
                    svg.appendChild(text); svg.appendChild(rect); svg.appendChild(pctText);
                    y += stepY; idx++;
                });
                el.appendChild(svg);
            }catch(e){ /* ignore */ }
        }

        async function loadConfigTab(){
            // load remote config if available
            try{
                const r = await fetch(API + '/admin/config'); if(r.ok){ const cfg = await r.json(); document.getElementById('cfg-force-local').checked = !!cfg.force_local; document.getElementById('cfg-confidence').value = cfg.confidence ?? 0.5; }
            }catch(e){ /* ignore */ }
        }

        async function saveConfigRemote(){
            const payload = { force_local: document.getElementById('cfg-force-local').checked, confidence: parseFloat(document.getElementById('cfg-confidence').value) };
            try{ const r = await fetch(API + '/admin/config', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)}); if(!r.ok) throw new Error('save failed'); alert('Saved'); }catch(e){ saveConfig(payload); alert('Saved locally (API unavailable)'); }
        }

        async function loadInbox(){
            const container = document.getElementById('queue-container'); container.innerHTML = 'Loading…';
            try{
                const r = await fetch(API + '/comments?limit=100'); if(!r.ok) throw new Error('no'); const comments = await r.json();
                // fetch tickets
                const t = await fetch(API + '/tickets'); const tickets = t.ok ? await t.json() : [];
                const ticketMap = {}; tickets.forEach(tt=> ticketMap[tt.comment_id] = tt);
                container.innerHTML = '';
                comments.forEach(c=>{
                    const div = document.createElement('div'); div.className='queue-item'; div.style.flexDirection='column';
                    const meta = `${c.intent || '—'} · ${c.emotion || '—'} · ${Math.round((c.confidence||0)*100)}%`;
                    let ticketHtml = '';
                    if(ticketMap[c.id]){
                        const tk = ticketMap[c.id]; ticketHtml = `<div style="margin-top:6px;color:var(--muted)">Ticket: ${tk.id} · ${tk.status}</div><div style="margin-top:6px"><button class="btn close-ticket" data-tid="${tk.id}">Close Ticket</button></div>`;
                    } else {
                        ticketHtml = `<div style="margin-top:6px"><button class="btn create-ticket" data-cid="${c.id}">Create Ticket</button></div>`;
                    }
                    div.innerHTML = `<div style="display:flex;justify-content:space-between;width:100%"><div style="flex:1"><div class="queue-comment">${escapeHtml(c.content)}</div><div style="color:var(--muted);font-size:12px">${meta}</div></div><div><span class="badge ${c.priority==='Critical'?'badge-critical':(c.priority==='High'?'badge-high':(c.priority==='Medium'?'badge-medium':'badge-low'))}">${c.priority}</span></div></div>${ticketHtml}`;
                    container.appendChild(div);
                });
                // wire create/close buttons
                container.querySelectorAll('.create-ticket').forEach(b=> b.addEventListener('click', async ()=>{ const cid=b.dataset.cid; try{ const res = await fetch(API + '/comments/', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({content: 'Ticket created for comment '+cid, source:'ui',})}); if(res.ok) { alert('Ticket created (via save)'); loadInbox(); } }catch(e){ alert('Failed to create ticket'); } }));
                container.querySelectorAll('.close-ticket').forEach(b=> b.addEventListener('click', async ()=>{ const tid=b.dataset.tid; try{ const res = await fetch(API + `/tickets/${tid}/close`, {method:'POST'}); if(res.ok){ alert('Ticket closed'); loadInbox(); } }catch(e){ alert('Failed'); } }));
            }catch(e){ container.innerHTML = '<div style="color:var(--muted)">Inbox unavailable</div>'; }
        }

        // fetch history for sparklines and draw
        async function loadHistory(){
            try{
                const r = await fetch(API + '/dashboard/metrics/history');
                if(!r.ok) throw new Error('no history');
                const payload = await r.json();
                const hours = payload.hours.map(h=> h.count);
                // draw sparklines
                drawSparkline(hours, 'spark-total');
                drawSparkline(hours.map((v,i)=> Math.round((i%6===0? (v*0.8+v*0.2):v))), 'spark-high');
                drawSparkline(hours.map((v,i)=> Math.round(v*0.3)), 'spark-resolved');
                drawSparkline(hours.map((v)=> Math.round((v/ (hours.reduce((a,b)=>a+b,0)||1))*100)), 'spark-confidence');
                // draw larger area chart
                drawAreaChart(hours, 'area-comments');
            }catch(e){ /* ignore history errors */ }
        }

        function drawSparkline(values, svgId){
            const svg = document.getElementById(svgId); if(!svg) return;
            const w = svg.getAttribute('width')*1 || 100; const h = svg.getAttribute('height')*1 || 28;
            if(!values || !values.length){ svg.innerHTML=''; return; }
            const max = Math.max(...values); const min = Math.min(...values);
            const len = values.length; const px = (i)=> (i/(len-1)) * (w-4) + 2;
            const py = (v)=> { if(max===min) return h/2; return h - 4 - ((v-min)/(max-min)) * (h-8); };
            const points = values.map((v,i)=> `${px(i)},${py(v)}`).join(' ');
            svg.innerHTML = `<polyline points="${points}" fill="none" stroke="#fff" stroke-opacity="0.85" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>`;
        }

        function renderStatusBars(statusArr){
            const container = document.getElementById('status-bars'); container.innerHTML='';
            if(!statusArr || !statusArr.length){ container.innerHTML = '<div style="color:var(--muted)">No status data</div>'; return; }
            const total = statusArr.reduce((s,x)=> s + (x.count||0),0) || 1;
            statusArr.forEach(s=>{
                const row = document.createElement('div'); row.className='row';
                const left = document.createElement('div'); left.style.flex='1'; left.innerHTML = `<div style="font-weight:700">${s.status}</div><div style="color:var(--muted);font-size:12px">${s.count}</div>`;
                const right = document.createElement('div'); right.style.width='48%';
                const barWrap = document.createElement('div'); barWrap.className='bar'; const fill = document.createElement('div'); fill.className='fill';
                const pct = Math.round((s.count/total)*100);
                fill.style.width = pct + '%';
                fill.style.background = s.status.toLowerCase().includes('closed') ? '#10b981' : (s.status.toLowerCase().includes('open') ? '#3b82f6' : '#8b5cf6');
                barWrap.appendChild(fill); right.appendChild(barWrap);
                row.appendChild(left); row.appendChild(right); container.appendChild(row);
            });
        }

        function drawAreaChart(values, svgId){
            const svg = document.getElementById(svgId); if(!svg) return;
            const w = 600; const h = 120; svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
            if(!values || !values.length){ svg.innerHTML=''; return; }
            const max = Math.max(...values); const min = Math.min(...values);
            const len = values.length; const px = (i)=> (i/(len-1)) * (w-20) + 10;
            const py = (v)=> { if(max===min) return h/2; return h - 10 - ((v-min)/(max-min)) * (h-30); };
            const points = values.map((v,i)=> `${px(i)},${py(v)}`).join(' ');
            // area path
            const areaPath = `M10,${h-10} L ${points} L ${w-10},${h-10} Z`;
            svg.innerHTML = `<path d="${areaPath}" fill="rgba(59,130,246,0.12)" stroke="none"></path><polyline points="${points}" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>`;
        }

        (function(){
            const savedTheme = localStorage.getItem('acas_theme'); if(savedTheme==='light') document.body.classList.add('light');
            const savedLang = localStorage.getItem('acas_lang')||'en'; langSel.value=savedLang; setLanguage(savedLang);
            // Eagerly populate Live metrics and history, and warm other tabs in background
            loadMetrics(); setInterval(loadMetrics,30000);
            // load historical series for sparklines
            loadHistory(); setInterval(loadHistory, 600000);
            // warm other tabs (non-blocking)
            renderRoutingRules(); renderSenticMappings(); loadConfigTab().catch(()=>{}); loadInbox().catch(()=>{});
            // populate Auto-Routing and verify
            console.log('Initializing Auto-Routing load');
            loadRoutingTab().catch((err)=>{ console.warn('loadRoutingTab failed', err); loadRoutingFallback(); }).finally(()=> setTimeout(verifyRoutingUI, 800));
            document.getElementById('add-rule').addEventListener('click', addRoutingRule);
            document.getElementById('add-mapping').addEventListener('click', addSenticMapping);
            renderSenticMappings();
            // config
            const cfg = loadConfig();
            document.getElementById('cfg-force-local').checked = cfg.force_local;
            document.getElementById('cfg-confidence').value = cfg.confidence;
            document.getElementById('save-config').addEventListener('click', ()=>{ saveConfigRemote(); });
            // refresh metrics button
            document.getElementById('refresh-metrics').addEventListener('click', ()=>{ loadMetrics(); document.getElementById('metrics-updated').textContent = new Date().toLocaleTimeString(); });
                // modal events
                document.getElementById('edit-rules').addEventListener('click', openRulesEditor);
                document.getElementById('close-modal').addEventListener('click', closeRulesEditor);
                document.getElementById('modal-add').addEventListener('click', addRuleFromModal);
        })();

        function verifyRoutingUI(){
            try{
                const rc = document.getElementById('r-support');
                const mini = document.getElementById('mini-total');
                if(!rc || !mini){
                    console.warn('Routing UI missing elements, retrying load');
                    loadRoutingTab().catch(()=> loadRoutingFallback());
                    // schedule a second check
                    setTimeout(()=>{ const rc2 = document.getElementById('r-support'); if(!rc2){ const card=document.getElementById('routing'); if(card) { console.warn('Injecting fallback routing panel'); fetch(API+'/dashboard/metrics').then(r=> r.ok? r.json(): null).then(m=> { renderRoutingFallbackHTML(card, m); }).catch(()=> { card.innerHTML = '<div class="card"><div style="color:var(--muted)">Auto-Routing temporarily unavailable. Check console for errors.</div></div>'; }); } } }, 1200);
                } else {
                    console.log('Routing UI present');
                }
            }catch(e){ console.error('verifyRoutingUI error', e); }
        }

        function renderRoutingFallbackHTML(containerEl, metrics){
            const m = metrics || { total_comments:0, pct_negative:0, priority_distribution:[], top_complaint:'—' };
            const total = m.total_comments || 0;
            const crisis = Math.round((m.pct_negative||0)*total);
            const pri = (m.priority_distribution||[]).reduce((acc, p)=> { const key = (p.priority||'').toLowerCase(); if(key.includes('critical')|| key.includes('high')) acc.tech += p.count; else if(key.includes('medium')) acc.product += p.count; else acc.support += p.count; return acc; }, {support:0,tech:0,product:0});
            const fmt = n=> n>=1000? (Math.round((n/1000)*10)/10)+'k': String(n);
            containerEl.innerHTML = `
                <div class="card">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <div>
                            <h3 style="margin:0">Auto-Routing Logic</h3>
                            <div style="color:var(--muted);font-size:13px;margin-top:6px">How ACAS distributes tickets across your stack</div>
                        </div>
                    </div>
                    <div style="display:flex;gap:18px;margin-top:12px">
                        <div style="width:260px">
                            <div class="mini-kpi card"><div style="color:var(--muted);font-size:12px">Total Routed (24h)</div><div class="val">${fmt(total)}</div></div>
                            <div class="mini-kpi card"><div style="color:var(--muted);font-size:12px">Avg. Confidence</div><div class="val">—</div></div>
                            <div class="mini-kpi card"><div style="color:var(--muted);font-size:12px">Crisis Alerts</div><div class="val">${crisis}</div></div>
                        </div>
                        <div style="flex:1">
                            <div style="display:flex;gap:20px">
                                <div class="route-card route-blue"><h4>Support Queue</h4><div class="route-count">${fmt(pri.support)}</div></div>
                                <div class="route-card route-purple"><h4>Tech / Bugs</h4><div class="route-count">${fmt(pri.tech)}</div></div>
                                <div class="route-card route-green"><h4>Product / Feedback</h4><div class="route-count">${fmt(pri.product)}</div></div>
                            </div>
                            <div style="margin-top:12px;color:var(--muted)">Top complaint: ${m.top_complaint || '—'}</div>
                        </div>
                    </div>
                </div>`;
        }

            // --- Modal & inline rule editor ---
            function openRulesEditor(){
                const m = document.getElementById('rule-modal'); m.style.display='flex'; loadRulesForEditor();
            }
            function closeRulesEditor(){ document.getElementById('rule-modal').style.display='none'; }

            async function loadRulesForEditor(){
                const list = document.getElementById('modal-rules-list'); list.innerHTML = 'Loading…';
                try{
                    const r = await fetch(API + '/admin/rules'); if(!r.ok) throw new Error('no'); const rules = await r.json(); renderModalRules(rules);
                }catch(e){ const rr = JSON.parse(localStorage.getItem('acas_rules')||'[]'); renderModalRules(rr); }
            }

            function renderModalRules(rules){
                const list = document.getElementById('modal-rules-list'); list.innerHTML='';
                rules.forEach(rule=>{
                    const row = document.createElement('div'); row.style.display='flex'; row.style.justifyContent='space-between'; row.style.alignItems='center'; row.style.padding='8px'; row.style.borderBottom='1px solid rgba(255,255,255,0.02)';
                    row.innerHTML = `<div style="flex:1;display:flex;gap:8px;align-items:center"><input style="flex:1;padding:8px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)" value="${escapeHtml(rule.pattern||rule.pattern||'')}"><select style="width:120px" class="sel-pri"><option${(rule.priority||'')==='Low'?' selected':''}>Low</option><option${(rule.priority||'')==='Medium'?' selected':''}>Medium</option><option${(rule.priority||'')==='High'?' selected':''}>High</option><option${(rule.priority||'')==='Critical'?' selected':''}>Critical</option></select><label style="margin-left:8px"><input type=checkbox ${rule.enabled? 'checked':''} class="sel-en"> Enabled</label></div><div style="display:flex;gap:8px"><button class="btn save-rule">Save</button><button class="btn del-rule">Delete</button></div>`;
                    list.appendChild(row);
                    const saveBtn = row.querySelector('.save-rule'); const delBtn = row.querySelector('.del-rule');
                    saveBtn.addEventListener('click', async ()=>{
                        const pattern = row.querySelector('input').value.trim(); const priority = row.querySelector('.sel-pri').value; const enabled = !!row.querySelector('.sel-en').checked;
                        try{ await fetch(API + `/admin/rules/${rule.id}`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({pattern,priority,enabled})}); }catch(e){ /* fallback: update localStorage */ const rr = JSON.parse(localStorage.getItem('acas_rules')||'[]'); const i = rr.findIndex(x=> x.pattern===rule.pattern); if(i>=0){ rr[i]={pattern,priority,enabled}; localStorage.setItem('acas_rules', JSON.stringify(rr)); } }
                        loadRulesForEditor(); renderRoutingRules();
                    });
                    delBtn.addEventListener('click', async ()=>{ if(!confirm('Delete this rule?')) return; try{ await fetch(API + `/admin/rules/${rule.id}`, {method:'DELETE'}); }catch(e){ const rr = JSON.parse(localStorage.getItem('acas_rules')||'[]'); const i = rr.findIndex(x=> x.pattern===rule.pattern); if(i>=0){ rr.splice(i,1); localStorage.setItem('acas_rules', JSON.stringify(rr)); } } loadRulesForEditor(); renderRoutingRules(); });
                });
            }

            async function addRuleFromModal(){ const p = document.getElementById('modal-new-pattern').value.trim(); const pr = document.getElementById('modal-new-priority').value; if(!p) return alert('Enter pattern'); try{ const r = await fetch(API + '/admin/rules', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({pattern:p,priority:pr,enabled:true})}); if(!r.ok) throw new Error('save failed'); document.getElementById('modal-new-pattern').value=''; loadRulesForEditor(); renderRoutingRules(); }catch(e){ const rr = JSON.parse(localStorage.getItem('acas_rules')||'[]'); rr.push({pattern:p,priority:pr,enabled:true}); localStorage.setItem('acas_rules', JSON.stringify(rr)); document.getElementById('modal-new-pattern').value=''; loadRulesForEditor(); renderRoutingRules(); } }

        // --- Routing rules (localStorage) ---
        async function renderRoutingRules(){
            const container = document.getElementById('routing-rules');
            try{
                const r = await fetch(API + '/admin/rules');
                if(!r.ok) throw new Error('error');
                const rules = await r.json();
                if(!rules.length) container.innerHTML = '<div style="color:var(--muted)">No rules yet</div>';
                else container.innerHTML = '';
                rules.forEach((rule)=>{
                    const row = document.createElement('div');
                    row.style.display='flex'; row.style.justifyContent='space-between'; row.style.alignItems='center'; row.style.marginTop='8px';
                    row.innerHTML = `<div><strong>${escapeHtml(rule.pattern)}</strong> → ${rule.priority} <div style="color:var(--muted);font-size:12px">${rule.enabled? 'enabled':'disabled'}</div></div><div style="display:flex;gap:8px"><button class="btn btn-del" data-id="${rule.id}" data-act="del">Delete</button></div>`;
                    container.appendChild(row);
                });
                container.querySelectorAll('button[data-act="del"]').forEach(b=> b.addEventListener('click', async ()=>{ const id=b.dataset.id; await fetch(API+`/admin/rules/${id}`, {method:'DELETE'}); renderRoutingRules(); }));
            }catch(e){
                // fallback to localStorage
                const rules = JSON.parse(localStorage.getItem('acas_rules')||'[]');
                if(!rules.length) container.innerHTML = '<div style="color:var(--muted)">No rules yet</div>';
                else{ container.innerHTML=''; rules.forEach((r,idx)=>{ const row=document.createElement('div'); row.textContent = `${r.pattern} -> ${r.priority}`; container.appendChild(row); }); }
            }
        }
        async function addRoutingRule(){
            const pattern = document.getElementById('rule-pattern').value.trim();
            const priority = document.getElementById('rule-priority').value;
            if(!pattern) return alert('Enter a pattern');
            try{
                const r = await fetch(API + '/admin/rules', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({pattern,priority})});
                if(!r.ok) throw new Error('save failed');
                await renderRoutingRules();
                document.getElementById('rule-pattern').value='';
            }catch(e){
                // local fallback
                const rules = JSON.parse(localStorage.getItem('acas_rules')||'[]'); rules.push({pattern,priority,enabled:true}); localStorage.setItem('acas_rules', JSON.stringify(rules)); renderRoutingRules(); document.getElementById('rule-pattern').value='';
            }
        }

        // --- Sentic mappings (localStorage) ---
        async function renderSenticMappings(){
            const table = document.getElementById('sentic-table');
            try{
                const r = await fetch(API + '/admin/sentics'); if(!r.ok) throw new Error('err'); const m = await r.json();
                if(!m.length) table.innerHTML = '<div style="color:var(--muted)">No mappings yet</div>';
                else{ table.innerHTML=''; m.forEach((row)=>{ const rdiv = document.createElement('div'); rdiv.style.display='flex'; rdiv.style.justifyContent='space-between'; rdiv.style.alignItems='center'; rdiv.style.marginTop='6px'; rdiv.innerHTML=`<div><strong>${escapeHtml(row.emotion)}</strong> → ${row.priority}</div><div style="display:flex;gap:8px"><button class="btn btn-del" data-id="${row.id}">Delete</button></div>`; table.appendChild(rdiv); }); table.querySelectorAll('.btn-del').forEach(b=> b.addEventListener('click', async ()=>{ const id=b.dataset.id; await fetch(API+`/admin/sentics/${id}`, {method:'DELETE'}); renderSenticMappings(); })); }
            }catch(e){
                const m = JSON.parse(localStorage.getItem('acas_sentics')||'[]'); if(!m.length) table.innerHTML = '<div style="color:var(--muted)">No mappings yet</div>'; else{ table.innerHTML=''; m.forEach((row,idx)=>{ const r = document.createElement('div'); r.textContent = `${row.emotion} -> ${row.priority}`; table.appendChild(r); }); }
            }
        }
        async function addSenticMapping(){ const e = document.getElementById('map-emotion').value.trim(); const p = document.getElementById('map-priority').value; if(!e) return alert('Enter emotion'); try{ const r = await fetch(API + '/admin/sentics', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({emotion:e,priority:p})}); if(!r.ok) throw new Error('save failed'); await renderSenticMappings(); document.getElementById('map-emotion').value=''; }catch(e){ const mm = JSON.parse(localStorage.getItem('acas_sentics')||'[]'); mm.push({emotion:e,priority:p}); localStorage.setItem('acas_sentics', JSON.stringify(mm)); renderSenticMappings(); document.getElementById('map-emotion').value=''; } }

        // --- Config ---
        function loadConfig(){ const def={force_local:true,confidence:0.5}; try{ const s=JSON.parse(localStorage.getItem('acas_cfg')||'null'); return s? s: def;}catch(e){return def} }
        function saveConfig(c){ localStorage.setItem('acas_cfg', JSON.stringify(c)); }
    </script>
</body>
</html>
